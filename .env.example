# =========================
# Django Core
# =========================
# Required: Generate a unique key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY="change-me-generate-a-new-key"
DEBUG=True
ALLOWED_HOSTS="localhost,127.0.0.1"

# =========================
# Database Configuration
# =========================
# Custom SQLite path for Docker persistence (default: src/db.sqlite3)
DATABASE_PATH="/app/data/db.sqlite3"

# Optional: Set USE_MYSQL=True to use MySQL
USE_MYSQL=False
DB_HOST=localhost
DB_PORT=3306
DB_NAME=storeapp
DB_USER=root
DB_PASSWORD=""
