# =========================
# Django Core
# =========================
# Required in production: Generate a unique key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY="change-me-generate-a-new-key"
DEBUG=True
ALLOWED_HOSTS="localhost,127.0.0.1"

# =========================
# Database Configuration
# =========================
# Default SQLite path for Docker local persistence
DATABASE_PATH="/app/data/db.sqlite3"

# Production PostgreSQL (Set USE_POSTGRES=True to enable)
USE_POSTGRES=False
DB_NAME="jrbstore"
DB_USER="postgres"
DB_PASSWORD=""
DB_HOST="localhost"
DB_PORT=5432

# Optional MySQL (Set USE_MYSQL=True to enable)
USE_MYSQL=False

# =========================
# AWS S3 Storage (Media)
# =========================
# Set USE_S3=True to store media files in AWS S3 (production)
USE_S3=False
AWS_STORAGE_BUCKET_NAME="my-jrbstore-media-bucket"
AWS_S3_REGION_NAME="us-east-1"
# Optional explicit keys (IAM Task Roles in ECS/Fargate will supply credentials automatically if left empty)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# =========================
# Security & Reverse Proxy (ALB / HTTPS)
# =========================
# Enable when running behind an Application Load Balancer with SSL termination
SECURE_PROXY_SSL_HEADER=False
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
CSRF_TRUSTED_ORIGINS="https://your-domain.com,https://your-alb.amazonaws.com"
